{
  "name": "solarsystem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ideia de sistema solar interativo",
  "scripts": {
    "build:css": "sass styles/styles.scss styles/styles.css --no-source-map --style=expanded",
    "watch:css": "sass --watch styles/styles.scss:styles/styles.css",
    "start": "npm run build:css && npx --yes serve -l 3000 .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "sass": "^1.77.8"
  }
}
